+/* Optional active-frame ranges.  Each line is "start end", end exclusive. */
+static int *active_ranges = NULL;
+static int active_range_count = 0;
+
+static int load_active_ranges(const char *path)
+{
+    FILE *fh = fopen(path, "r");
+    int start, end;
+    int capacity = 64;
+
+    if (!fh)
+        return -1;
+    active_ranges = malloc((size_t)capacity * 2 * sizeof(int));
+    if (!active_ranges) {
+        fclose(fh);
+        return -1;
+    }
+    while (fscanf(fh, "%d %d", &start, &end) == 2) {
+        if (end <= start)
+            continue;
+        if (active_range_count == capacity) {
+            int *grown;
+            capacity *= 2;
+            grown = realloc(active_ranges, (size_t)capacity * 2 * sizeof(int));
+            if (!grown) {
+                fclose(fh);
+                return -1;
+            }
+            active_ranges = grown;
+        }
+        active_ranges[active_range_count * 2] = start;
+        active_ranges[active_range_count * 2 + 1] = end;
+        active_range_count++;
+    }
+    fclose(fh);
+    return 0;
 }
 
